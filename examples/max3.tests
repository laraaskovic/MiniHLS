# i16 max3(i16 a, i16 b, i16 c)
# a b c -> result

# the three positions of the winner, and a tie
1 2 3 -> 3
3 2 1 -> 3
2 3 1 -> 3
5 5 3 -> 5

# negatives, where an unsigned comparator would pick the wrong one:
# -1 as u16 is 65535, so ugt would answer -1 here and 32768 below
-5 -2 -9 -> -2
-1 0 0 -> 0
-32768 0 0 -> 0
0 -1 -1 -> 0

# the corners of i16
0 0 0 -> 0
32767 -32768 0 -> 32767
32767 32767 32767 -> 32767
-32768 -32768 -32768 -> -32768
