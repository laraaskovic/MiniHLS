# u16 abs_diff(i16 a, i16 b)
# a b -> result

0 0 -> 0
5 3 -> 2
3 5 -> 2

# either operand negative, and the sign of the difference either way
-5 3 -> 8
3 -5 -> 8
-1 0 -> 1
0 -1 -> 1

# equal operands at the corners: the difference is 0, not the corner
32767 32767 -> 0
-32768 -32768 -> 0

# 32768 does not fit i16, which is why the result type is u16 and not i16
-32768 0 -> 32768
0 -32768 -> 32768
-1 -32768 -> 32767

# the widest possible difference: 65535 needs all 16 result bits,
# and the i17 intermediate that produced it
32767 -32768 -> 65535
-32768 32767 -> 65535
