# Cell count for the width-8 adder wrapper.
#
# Run from the repository root:
#   yosys characterize/yosys/cell_count.ys
#
# For a sweep across widths use scripts/area_report.sh, which drives
# minihls_adder directly with -chparam instead of going through a wrapper.

read_verilog -sv hw/adder8.sv hw/minihls_adder.sv
hierarchy -check -top adder8

proc
opt

# Lower the generic $add cell to gates so the count reflects real area rather
# than a single abstract operator.
techmap
opt

stat
